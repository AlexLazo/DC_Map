DATABASE_URL=sqlite:///./dc_map.db
SESSION_SECRET=replace-this-with-a-long-random-string

# Correo diario de cierre (9:00 AM hora del CD). Con Resend (recomendado en Railway):
MAIL_FROM=DC Map <onboarding@resend.dev>
RESEND_API_KEY=
# O por SMTP (Railway lo bloquea en varios planes):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# Opcionales: DIGEST_HOUR=9  DIGEST_MINUTE=0  APP_BASE_URL=https://tu-app.up.railway.app
